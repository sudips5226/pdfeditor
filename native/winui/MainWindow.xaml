<Window x:Class="PdfEditor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="16" RowSpacing="8" KeyDown="Editor_KeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="pdfeditor - P5D Quality-First Presentation" FontSize="20"/>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
   <Button x:Name="OpenDocument" Content="Open PDF..." Tag="Open" Click="Output_Click"/>
   <Button Content="Left" Tag="Left" Click="Pan_Click"/><Button Content="Right" Tag="Right" Click="Pan_Click"/>
   <Button Content="Up" Tag="Up" Click="Pan_Click"/><Button Content="Down" Tag="Down" Click="Pan_Click"/>
   <Button Content="Zoom -" Tag="Out" Click="Zoom_Click"/><Button Content="Zoom +" Tag="In" Click="Zoom_Click"/>
   <CheckBox x:Name="RotatePage" Content="View 90 degrees" Click="ValidateCore_Click"/>
   <TextBox x:Name="PageInput" Text="1" Width="64" PlaceholderText="Page"/>
   <Button Content="Go" Click="GoTo_Click"/>
   <TextBlock x:Name="CurrentPageText" Text="Page --" VerticalAlignment="Center"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
   <Button x:Name="DeletePages" Content="Delete" Tag="Delete" Click="Edit_Click"/>
   <TextBox x:Name="MoveInput" Text="1" Width="64" PlaceholderText="Before"/>
   <Button x:Name="MovePages" Content="Move Before" Tag="Move" Click="Edit_Click"/>
   <Button x:Name="RotateLeft" Content="Rotate Left" Tag="RotateLeft" Click="Edit_Click"/>
   <Button x:Name="RotateRight" Content="Rotate Right" Tag="RotateRight" Click="Edit_Click"/>
   <Button x:Name="UndoEdit" Content="Undo" Tag="Undo" Click="Edit_Click"/>
   <Button x:Name="RedoEdit" Content="Redo" Tag="Redo" Click="Edit_Click"/>
   <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Text="0 pages selected"/>
   <TextBlock x:Name="EditMessage" VerticalAlignment="Center"/>
  </StackPanel>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="Wheel scroll; Ctrl+wheel zoom at cursor." TextWrapping="WrapWholeWords" Height="132" FontSize="11"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
   <Button x:Name="DuplicatePages" Content="Duplicate" Tag="Duplicate" Click="Edit_Click"/>
   <Button Content="Insert PDF..." Tag="Insert" Click="Output_Click"/>
   <Button x:Name="ExtractPages" Content="Extract Selected..." Tag="Extract" Click="Output_Click"/>
   <Button x:Name="SaveDocument" Content="Save As..." Tag="Save" Click="Output_Click"/>
   <Button x:Name="CancelOutput" Content="Cancel Output" Tag="Cancel" Click="Output_Click"/>
   <TextBlock x:Name="OutputText" Text="Output idle" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
  </StackPanel>
  <Grid Grid.Row="5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,8,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button Content="Show Current" Click="ShowCurrent_Click" Margin="0,0,0,4"/>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
     <Grid x:Name="ThumbnailClip" SizeChanged="Thumbnails_SizeChanged" PointerWheelChanged="Thumbnails_Wheel">
      <Canvas x:Name="ThumbnailCanvas"/>
     </Grid>
     <ScrollBar Grid.Column="1" x:Name="ThumbnailScroll" Orientation="Vertical" Width="18" IndicatorMode="MouseIndicator" IsTabStop="True" ValueChanged="Thumbnails_Scroll"/>
    </Grid>
   </Grid>
   <Border Grid.Column="1" BorderThickness="1" BorderBrush="Gray"><SwapChainPanel x:Name="DocumentCanvas" PointerWheelChanged="Canvas_Wheel" SizeChanged="Canvas_SizeChanged"/></Border>
   <ScrollBar Grid.Column="2" x:Name="DocumentScroll" Orientation="Vertical" Width="18" IndicatorMode="MouseIndicator" IsTabStop="True" ValueChanged="Document_Scroll"/>
  </Grid>
 </Grid>
</Window>
