<Window x:Class="PdfEditor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="16" RowSpacing="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="pdfeditor - P4 continuous viewer" FontSize="20"/>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
   <Button Content="Open / update" Click="ValidateCore_Click"/>
   <Button Content="Left" Tag="Left" Click="Pan_Click"/><Button Content="Right" Tag="Right" Click="Pan_Click"/>
   <Button Content="Up" Tag="Up" Click="Pan_Click"/><Button Content="Down" Tag="Down" Click="Pan_Click"/>
   <Button Content="Zoom -" Tag="Out" Click="Zoom_Click"/><Button Content="Zoom +" Tag="In" Click="Zoom_Click"/>
   <CheckBox x:Name="RotatePage" Content="90 degrees" Click="ValidateCore_Click"/>
   <TextBox x:Name="PageInput" Text="1" Width="64" PlaceholderText="Page"/>
   <Button Content="Go" Click="GoTo_Click"/>
   <TextBlock x:Name="CurrentPageText" Text="Page --" VerticalAlignment="Center"/>
  </StackPanel>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="Wheel scroll; Ctrl+wheel zoom at cursor." TextWrapping="WrapWholeWords" Height="54" FontSize="12"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border BorderThickness="1" BorderBrush="Gray"><SwapChainPanel x:Name="DocumentCanvas" PointerWheelChanged="Canvas_Wheel" SizeChanged="Canvas_SizeChanged"/></Border>
   <ScrollBar Grid.Column="1" x:Name="DocumentScroll" Orientation="Vertical" Width="18" IndicatorMode="MouseIndicator" IsTabStop="True" ValueChanged="Document_Scroll"/>
  </Grid>
 </Grid>
</Window>
